parameters:
	ignoreErrors:
		-
			message: '#^Binary operation "\." between ''https\://discovery…'' and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 2
			path: NationalArchivesUk.php

		-
			message: '#^Cannot access offset ''description'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Cannot access offset 0 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 3
			path: NationalArchivesUk.php

		-
			message: '#^Method Omnistate\\NationalArchivesUk\\NationalArchivesUk\:\:ask\(\) has parameter \$query with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Method Omnistate\\NationalArchivesUk\\NationalArchivesUk\:\:ask\(\) should return array\<string, mixed\>\|null but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Method Omnistate\\NationalArchivesUk\\NationalArchivesUk\:\:search\(\) should return list\<Omnistate\\Model\\CivilRecord\> but returns array\<Omnistate\\Model\\CivilRecord\>\.$#'
			identifier: return.type
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(mixed\)\: mixed\)\|null, Closure\(array\)\: Omnistate\\Model\\CivilRecord given\.$#'
			identifier: argument.type
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Parameter \#1 \$record of method Omnistate\\NationalArchivesUk\\NationalArchivesUk\:\:record\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Parameter \#1 \$string of function trim expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Parameter \#2 \$array of function array_map expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Parameter \#2 \$array of function implode expects array\<string\>, array\<int, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Parameter \#3 \$reference of class Omnistate\\Model\\Archive constructor expects string\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: NationalArchivesUk.php

		-
			message: '#^Method Omnistate\\NationalArchivesUk\\Tests\\NationalArchivesUkContractTest\:\:civilIdentifier\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: Tests/NationalArchivesUkContractTest.php

		-
			message: '#^Method Omnistate\\NationalArchivesUk\\Tests\\NationalArchivesUkContractTest\:\:civilQuery\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: Tests/NationalArchivesUkContractTest.php

		-
			message: '#^Parameter \#1 \$body of class Symfony\\Component\\HttpClient\\Response\\MockResponse constructor expects iterable\<string\|Throwable\>\|string, string\|false given\.$#'
			identifier: argument.type
			count: 3
			path: Tests/NationalArchivesUkTest.php

		-
			message: '#^Using nullsafe property access on non\-nullable type Omnistate\\Model\\Archive\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 3
			path: Tests/NationalArchivesUkTest.php
